@page "/Books"
@model BooksModel
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Library Inventory</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
</head>
<body>
    <div class="d-flex">
        <!-- Sidebar -->
        <nav class="p-3 border bg-white" style="width: 220px; min-height: 100vh;">
            <h4 class="mb-4">Library</h4>
            <ul class="nav flex-column">
                <li class="nav-item"><a class="nav-link" href="/Dashboard">Dashboard</a></li>
                <li class="nav-item"><a class="nav-link" href="/Books">Books</a></li>
                <li class="nav-item"><a class="nav-link" href="/Users">Users</a></li>
                <li class="nav-item"><a class="nav-link" href="/BorrowingLog">Borrowing Log</a></li>
            </ul>
        </nav>

        <!-- Main content -->
        <div class="flex-grow-1 p-4">
            <h2 class="mb-4">Library Inventory</h2>

            <div class="mb-3 d-flex flex-wrap gap-2">
                <button class="btn btn-success">New Book</button>
                <button class="btn btn-info">Import Books</button>
                <button class="btn btn-warning">Manage Categories</button>
            </div>

            <div class="table-responsive">
                <table class="table table-striped table-hover align-middle">
                    <thead class="table-dark">
                        <tr>
                            <th>ID</th>
                            <th>Title</th>
                            <th>Author</th>
                            <th>Copies</th>
                            <th>Status</th>
                            <th>Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var book in Model.Books)
                        {
                            <tr>
                                <td>@book.Id</td>
                                <td>@book.Title</td>
                                <td>@book.Author</td>
                                <td>@book.CopiesAvailable</td>
                                <td>
                                    @if (book.IsAvailable)
                                    {
                                        <span class="badge bg-success">Available</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-danger">Not Available</span>
                                    }
                                </td>
                                <td>
                                    <form method="post" asp-page-handler="Borrow" class="d-inline">
                                        <input type="hidden" name="id" value="@book.Id" />
                                        <input type="hidden" name="userId" value="1" />
                                        <button type="submit" class="btn btn-primary btn-sm">Borrow</button>
                                    </form>
                                    <form method="post" asp-page-handler="Return" class="d-inline">
                                        <input type="hidden" name="id" value="@book.Id" />
                                        <input type="hidden" name="userId" value="1" />
                                        <button type="submit" class="btn btn-secondary btn-sm">Return</button>
                                    </form>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
