@page
@model LoginModel

<h2>Login</h2>

<form method="post">
    <div>
        <label>Username</label>
        <input asp-for="Login.Username" />
    </div>
    <div>
        <label>Password</label>
        <input asp-for="Login.Password" type="password" />
    </div>
    <button type="submit">Log In</button>
</form>
